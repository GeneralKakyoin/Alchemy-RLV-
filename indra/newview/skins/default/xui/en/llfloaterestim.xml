<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 name="estim"
 title="E-Stim Device Controls"
 width="340"
 height="430"
 min_width="340"
 min_height="430"
 can_resize="false"
 can_minimize="true"
 can_close="true"
 save_rect="true">

    <text name="status_label" left="10" top="10" width="300" height="15">
        Connection: Disconnected
    </text>
    <text name="battery_label" left="10" top="25" width="300" height="15">
        Coyote Battery: Unknown
    </text>

    <text name="log_title" left="10" top="45" width="300" height="15">
        Sent E-Stim Commands:
    </text>
    <scroll_list name="command_log" left="10" top="65" width="320" height="150">
        <scroll_list.column name="command" label="Command" width="300" />
    </scroll_list>

    <text name="graph_title" left="10" top="225" width="300" height="15">
        Power Output History (A: Cyan, B: Magenta):
    </text>
    <!-- Graph draws dynamically in the area: top="245" to "345" -->

    <button
     name="panic_button"
     label="PANIC STOP"
     left="10"
     top="360"
     width="320"
     height="40"
     font="SansSerifLarge" />
</floater>
